        </mxCell>
        <mxCell id="warn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0B83F;fontColor=#172B4D;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" value="WARN&#xa;Publish with quality flags&#xa;CloudWatch alarm + SNS owner notice" vertex="1">
          <mxGeometry height="115" width="500" x="610" y="870" as="geometry" />
        </mxCell>
        <mxCell id="fail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DD344C;fontColor=#172B4D;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" value="FAIL&#xa;Hold affected region/window&#xa;Keep previous Gold active&#xa;S3 quarantine + SNS + SQS remediation" vertex="1">
          <mxGeometry height="115" width="500" x="1165" y="870" as="geometry" />
        </mxCell>
        <mxCell id="replay" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2E73B8;fontColor=#172B4D;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" value="CONTROLLED REPLAY&#xa;Authorized Step Functions execution → DynamoDB lock → temporary checkpoint&#xa;recompute affected partitions → reconcile → close immutable audit record" vertex="1">
          <mxGeometry height="115" width="620" x="1720" y="870" as="geometry" />
        </mxCell>
        <mxCell id="late" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0B83F;fontColor=#172B4D;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=6;align=left;verticalAlign=top;spacing=8;" value="LATE DATA &amp; IDEMPOTENCY: event time drives analytics; ingestion time drives operations. Use a documented allowed-lateness watermark. Reopen only affected regional partitions. Conditional DynamoDB writes prevent concurrent processing, and event_id/topic/partition/offset prevent double counting." vertex="1">
          <mxGeometry height="105" width="1130" x="30" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="state" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0B83F;fontColor=#172B4D;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=6;align=left;verticalAlign=top;spacing=8;" value="RUC STATE MACHINE EXAMPLE: CREATED → SCHEDULED → DOWNLOADING → DOWNLOAD_COMPLETED → INSTALLING → SUCCESS | FAILED | ROLLED_BACK. Invalid transitions remain traceable with is_valid_transition=false and are excluded or flagged in Gold, never silently deleted." vertex="1">
          <mxGeometry height="105" width="1180" x="1190" y="1030" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
